{
  "name": "modern-color",
  "version": "1.3.0",
  "author": "Ron Gilchrist (thewebkid)",
  "description": "An ES Next color class that simplifies color parsing and conversion. Implements most common color functions.",
  "keywords": [
    "colors",
    "rgb",
    "hsl",
    "hsv",
    "cmyk",
    "oklch",
    "esnext",
    "color",
    "typescript",
    "color-manipulation",
    "color-conversion",
    "color-parser"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thewebkid/modern-color.git"
  },
  "homepage": "https://thewebkid.com/modules/modern-color",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "eslint": "^8.52.0"
  }
}
